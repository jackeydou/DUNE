# Copy to .env and fill in. docker compose reads .env from this directory.

# Secrets. Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# The name or address people type to reach the console and the CLI, and the port.
SWARM_HOST=localhost
SWARM_PORT=7443
# The host interface the port is published on. 127.0.0.1 keeps it to this machine.
SWARM_BIND=0.0.0.0

# sandboxd keeps sandboxes' key paths here. The docker daemon must see the same path.
SWARM_STATE_DIR=/var/lib/swarmeval/sandboxd
# auto uses gVisor (runsc) when docker has it, runc otherwise.
SWARM_SANDBOX_RUNTIME=auto

# The model-gateway config: backends and the model names cases may use.
SWARM_GATEWAY_CONFIG=./gateway.yaml

# The key the analysis service's judge calls model-gateway with: at least 32 characters, and
# `analysis_key_env: SWARMEVAL_ANALYSIS_KEY` in gateway.yaml. Empty, the judge is off.
SWARM_ANALYSIS_KEY=

# 1 lets cases load extensions from their own directory; that code runs inside the worker.
SWARM_ALLOW_CASE_CODE=0
